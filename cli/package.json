{
  "name": "wa-pro",
  "version": "1.0.0",
  "type": "module",
  "description": "CLI for querying WhatsApp Pro observer messages",
  "bin": {
    "wa-pro": "./bin/run.mjs"
  },
  "oclif": {
    "bin": "wa-pro",
    "commands": {
      "strategy": "pattern",
      "target": "./src/commands"
    },
    "topicSeparator": " "
  },
  "dependencies": {
    "@oclif/core": "^4.2.10",
    "json5": "^2.2.3",
    "tsx": "^4.19.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  }
}
