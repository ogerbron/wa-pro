{
  "name": "whatsapp-pro",
  "version": "2026.11.3",
  "private": true,
  "description": "WhatsApp channel plugin with observer mode for passive message logging",
  "type": "module",
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "typebox": "1.3.35",
    "zod": "^4.6.5",
    "json5": "^2.2.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.11.3"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "vitest": "^3.1.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "tsx": "^4.19.0",
    "esbuild": "^0.28.2",
    "openclaw": "2026.11.3"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "compat": {
      "pluginApi": ">=2026.11.3"
    },
    "channel": {
      "id": "whatsapp-pro",
      "label": "WhatsApp Pro",
      "selectionLabel": "WhatsApp Pro (QR link + observer)",
      "docsPath": "/channels/whatsapp",
      "blurb": "WhatsApp messaging with passive SQLite history."
    },
    "setupFeatures": {
      "configPromotion": "preserve-root"
    }
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "scripts": {
    "test": "vitest run",
    "check": "npm run check:db && npm run check:compat",
    "check:compat": "node --import tsx scripts/check-compat.ts",
    "check:db": "tsc --project tsconfig.observer.json"
  }
}
